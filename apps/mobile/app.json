        "backgroundColor": "#050505"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": ["expo-router", "expo-secure-store", "@clerk/expo"],
    "extra": {
      "eas": {
        "projectId": "6a8add25-4ded-4ba5-95f4-acbc914ea22d"
      }
    }
